# ============================================================
#  SCI CLUB ADRANO — BACKEND · esempio configurazione
#  Copia questo file in ".env" e compila i valori reali.
#  NON committare MAI il file .env.
# ============================================================

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Origini autorizzate dal CORS (una o più, separate da virgola).
# In sviluppo viene sempre permesso localhost.
FRONTEND_URL=http://localhost:3000

# Origine PUBBLICA del frontend (Cloudflare Pages / Workers).
# Deve combaciare ESATTAMENTE con l'origine mostrata nel browser,
# senza slash finale. Esempio:
#   https://sciclub-adrano.pages.dev
#   https://nome-progetto.nome-account.workers.dev
FRONTEND_PUBLIC_URL=https://sciclub-adrano.pages.dev

# Metti "true" SOLO se il backend gira dietro un reverse proxy
# (Nginx, Cloudflare Tunnel, ecc.).
TRUST_PROXY=false

# ------------------------------------------------------------
# DATABASE MariaDB / MySQL
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sci_club_adrano

# ------------------------------------------------------------
# SESSIONE ADMIN
# Genera un valore casuale lungo, ad esempio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
SESSION_SECRET=

# "lax" in sviluppo (http). In produzione su HTTPS puoi usare "none".
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ------------------------------------------------------------
# ACCOUNT ADMIN INIZIALE
# ADMIN_PASSWORD viene usata SOLO alla prima inizializzazione:
# se la tabella admin è vuota e questa variabile è impostata,
# il backend crea l'account. Non salvare mai password in chiaro.
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ------------------------------------------------------------
# EMAIL (Nodemailer / SMTP)
# Per Gmail usare una APP PASSWORD (16 caratteri), NON la password
# normale dell'account. SMTP_PASSWORD non va MAI inserita nel codice
# né committata: resta solo nel .env locale (già in .gitignore).
# Se una di queste variabili manca, il servizio email risulta
# NON configurato e i dati vengono comunque salvati nel database.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=autketchup@gmail.com
SMTP_PASSWORD=
EMAIL_FROM="Sci Club Adrano <autketchup@gmail.com>"

# SVILUPPO  -> email di test
EMAIL_TO=autketchup@gmail.com
# PRODUZIONE -> email dello Sci Club (cambia solo questa riga)
# EMAIL_TO=sciclub.adrano@gmail.com
